# Runtime and database
NODE_ENV=development
SERVER_PORT=5000
MONGO_URI=
REQUIRE_DATABASE=false
JSON_BODY_LIMIT=1mb
TRUST_PROXY=1

# Authentication
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=samira-collection-api
JWT_AUDIENCE=samira-collection-web
BCRYPT_ROUNDS=12
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax
ALLOW_REFRESH_TOKEN_BODY=false
RETURN_REFRESH_TOKEN_IN_BODY=false
ALLOW_OFFLINE_AUTH=false

# Mobile OTP login
# Use demo/mock only for local development. Production must use a live provider.
OTP_MODE=demo
DEMO_OTP=123456
OTP_DEV_CODE=
OTP_PROVIDER=mock
EMAIL_OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3
OTP_RESEND_COOLDOWN_SECONDS=60
ALLOW_DEV_OTP=false
ADMIN_PHONE_NUMBERS=
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_9999133567_ACCOUNT_SID=
SMS_9999133567_AUTH_TOKEN=
SMS_9999133567_SENDER_ID=

# Public application URLs
PUBLIC_API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:5000/api
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PLATFORM_ROOT_DOMAIN=
BROWSER=none

# Product media storage. Configure R2 or Cloudinary in backend/.env.
REQUIRE_MEDIA_STORAGE=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=samira-products
R2_PUBLIC_URL=
R2_FOLDER=products
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=samira-products

# Payments
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Reel Product Import
ENABLE_REEL_PRODUCT_IMPORT=true
REDIS_URL=
REDIS_REST_URL=
REDIS_REST_TOKEN=
REDIS_TIMEOUT_MS=2500
REEL_WORKER_CONCURRENCY=1
REEL_PROCESSING_TIMEOUT_MINUTES=20
REEL_JOB_MAX_ATTEMPTS=3
MAX_REEL_DURATION_SECONDS=180
MAX_REEL_FILE_SIZE_MB=250
REEL_FRAMES_PER_SECOND=3
REEL_SCENE_THRESHOLD=0.30
REEL_EXACT_DUPLICATE_SIMILARITY=0.96
REEL_SAME_PRODUCT_SIMILARITY=0.88
REEL_DIFFERENT_PRODUCT_SIMILARITY=0.80
AI_VIDEO_WORKER_URL=
AI_VIDEO_WORKER_SERVICE_TOKEN=
REEL_ORIGINAL_RETENTION_DAYS=30
REEL_REJECTED_FRAME_RETENTION_DAYS=7
REEL_TEMP_FILE_RETENTION_HOURS=24

# Smart Quick Add and Reel suggestions
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Shipping and returns
SHIPPING_PROVIDER=disabled
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_TOKEN=
RETURN_WINDOW_DAYS=7

# Inventory and documents
INVENTORY_CLEANUP_INTERVAL_MS=60000
INVENTORY_RESERVATION_MINUTES=15
INVOICE_PREFIX=SC

# Optional integrations
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/oauth/callback
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Samira Collection
SUPPORT_NOTIFICATION_EMAIL=
ALLOW_DEV_DATA_FALLBACK=false
