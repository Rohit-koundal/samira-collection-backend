# NODE_ENV=production makes MONGO_URI, JWT_SECRET and JWT_REFRESH_SECRET
# mandatory. The server refuses to start without them.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/samira-collection?retryWrites=true&w=majority
REQUIRE_DATABASE=false
JWT_SECRET=change_this_to_a_long_random_secret
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP_MODE=demo       -> issues the fixed DEMO_OTP below and returns it in the
#                        API response so the app can be demonstrated without an
#                        SMS provider.
# OTP_MODE=production -> issues a random code, never returns it to the client,
#                        and fails the request if the SMS provider is down.
OTP_MODE=demo
DEMO_OTP=123456

OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_PHONE_NUMBERS=9876543210
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_9999133567_ACCOUNT_SID=
SMS_9999133567_AUTH_TOKEN=
SMS_9999133567_SENDER_ID=
SERVER_PORT=5000
PUBLIC_API_URL=http://localhost:5000
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
ENABLE_REEL_PRODUCT_IMPORT=true
REDIS_URL=
REEL_WORKER_CONCURRENCY=1
REEL_PROCESSING_TIMEOUT_MINUTES=20
REEL_JOB_MAX_ATTEMPTS=3
MAX_REEL_DURATION_SECONDS=180
MAX_REEL_FILE_SIZE_MB=250
REEL_FRAMES_PER_SECOND=3
REEL_SCENE_THRESHOLD=0.30
REEL_EXACT_DUPLICATE_SIMILARITY=0.96
REEL_SAME_PRODUCT_SIMILARITY=0.88
REEL_DIFFERENT_PRODUCT_SIMILARITY=0.80
AI_VIDEO_WORKER_URL=
AI_VIDEO_WORKER_SERVICE_TOKEN=
REEL_ORIGINAL_RETENTION_DAYS=30
REEL_REJECTED_FRAME_RETENTION_DAYS=7
REEL_TEMP_FILE_RETENTION_HOURS=24

# Image storage priority: R2 > Cloudinary > local uploads/
# Cloudflare R2 (recommended for production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=samira-products
R2_PUBLIC_URL=
R2_FOLDER=products

# Cloudinary (optional fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=samira-products

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Used to verify Razorpay webhook signatures. Required for payment.captured
# recovery when the customer closes the browser before the frontend callback.
RAZORPAY_WEBHOOK_SECRET=

# Host resolution only. Do not automate DNS. Sellers point a CNAME themselves.
PLATFORM_ROOT_DOMAIN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5000/api/instagram/oauth/callback
R2_ACCESS_KEY_ID= edf451f6c9baed1363026a5e985d6a8e
R2_ACCOUNT_ID =76a33ca82274e4bd5ebfb6b37904081a
R2_BUCKET_NAME= macinfotech
R2_FOLDER =samira/products
R2_PUBLIC_URL = https://pub-ea7aa7fc86ca498997025c924dad4427.r2.dev 
R2_SECRET_ACCESS_KEY =261539455fb42e590a5fbcd249d0510d218ccd8132dc7f7ed813bbd7b8c48dc8

# Courier credentials are detected only. Live AWB booking stays disabled
# unless a complete provider integration is added later.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_TOKEN=

PUBLIC_SITE_URL=http://localhost:3000

# Optional. Free Google AI Studio key for Quick Add photo reading.
# Get one at https://aistudio.google.com/apikey
# Quick Add still works without this; photos will not be auto-described.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

