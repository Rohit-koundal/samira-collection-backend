OTP_DEV_CODE=123456
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
ADMIN_PHONE_NUMBERS=9876543210
