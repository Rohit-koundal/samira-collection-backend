NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/samira-collection?retryWrites=true&w=majority
REQUIRE_DATABASE=false
REQUIRE_MEDIA_STORAGE=false
JWT_SECRET=<generate-a-random-secret-with-at-least-32-characters>
JWT_REFRESH_SECRET=<generate-a-different-random-secret-with-at-least-32-characters>
OTP_HASH_SECRET=<generate-a-third-random-secret-with-at-least-32-characters>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=samira-collection-api
JWT_AUDIENCE=samira-collection-web
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
RETURN_REFRESH_TOKEN_IN_BODY=false
ALLOW_REFRESH_TOKEN_BODY=false
ALLOW_DEV_OTP=false
ALLOW_OFFLINE_AUTH=false
ALLOW_DEV_DATA_FALLBACK=false
OTP_DEV_CODE=<six-digit-development-only-code>
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
EMAIL_OTP_PROVIDER=mock
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Samira Collection
REDIS_REST_URL=
REDIS_REST_TOKEN=
REDIS_TIMEOUT_MS=2500
BCRYPT_ROUNDS=12
SERVER_PORT=5000
TRUST_PROXY=1
JSON_BODY_LIMIT=1mb
PUBLIC_API_URL=http://localhost:5000
CLIENT_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# Image storage priority: R2 > Cloudinary > local uploads/
# Cloudflare R2 (recommended for production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=samira-products
R2_PUBLIC_URL=
R2_FOLDER=products

# Cloudinary (optional fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=samira-products

# Enable only after keys and the signed webhook are configured
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
INVENTORY_RESERVATION_MINUTES=15
INVENTORY_CLEANUP_INTERVAL_MS=60000
RETURN_WINDOW_DAYS=7

# Optional support notifications (requests are stored even when unset)
SUPPORT_NOTIFICATION_EMAIL=

# Shipping is intentionally disabled until a real provider is configured
SHIPPING_PROVIDER=disabled
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Invoice numbering and seller/GST details are managed through admin settings
INVOICE_PREFIX=SC
